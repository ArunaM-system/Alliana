# ALLINA Platform Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Never commit .env with real credentials.

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security
SECRET_KEY=allina-dev-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=allina_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@db:5432/allina_db

# Background Processing (Redis & Celery)
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Workflow Orchestration (Temporal - interface placeholder for later phase)
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# Policy Engine (OPA - interface placeholder for later phase)
OPA_URL=http://opa:8181/v1/data/allina/policy

# LLM Gateway Defaults (interface placeholder for later phase)
DEFAULT_LLM_PROVIDER=mock
